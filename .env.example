# Copy to .env and fill in to run against real IBM Quantum hardware.
# Not needed for the local aer_simulator backend.
# IBM_QUANTUM_TOKEN is an IBM Cloud API key (console.cloud.ibm.com > API keys).
# IBM_QUANTUM_INSTANCE is the CRN of your Quantum instance (quantum.cloud.ibm.com).
IBM_QUANTUM_TOKEN=
IBM_QUANTUM_INSTANCE=
